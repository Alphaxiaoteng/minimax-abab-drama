.es-skeleton {
  padding: 8rpx 0;
}

.es-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EDEFF2 25%, #F7F8FA 37%, #EDEFF2 63%);
  background-size: 400% 100%;
  animation: es-shimmer 1.4s ease infinite;
  margin-bottom: 18rpx;
}

.es-line-0 { width: 92%; }
.es-line-1 { width: 74%; }
.es-line-2 { width: 84%; }

@keyframes es-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.es-empty {
  padding: 60rpx 24rpx;
  text-align: center;
}

.es-icon {
  font-size: 64rpx;
  color: var(--border);
  line-height: 1;
  margin-bottom: 20rpx;
}

.es-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.es-desc {
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.es-action {
  display: inline-block;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #FFFFFF;
  font-size: 28rpx;
}

.hero {
  background: linear-gradient(135deg, #1F6FEB 0%, #3B82F6 55%, #60A5FA 100%);
  border-radius: var(--radius);
  padding: 40rpx 32rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.hero-metrics {
  display: flex;
  margin-top: 32rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.metric-label {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.hero-tags {
  display: flex;
  margin-top: 28rpx;
}

.hero-tags .tag {
  margin-right: 14rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
}

.scene-card {
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

/* hover-class 按压态：真机（尤其安卓）上 :active 不可靠，官方机制是 hover-class */
.scene-card-pressed {
  transform: scale(0.975);
  box-shadow: 0 4rpx 16rpx rgba(31, 111, 235, 0.16);
  background: #F8FAFF;
}

.scene-body {
  flex: 1;
  padding-right: 20rpx;
}

.scene-title {
  font-size: 32rpx;
  font-weight: 600;
}

.scene-desc {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.5;
}

.scene-go {
  flex: none;
  font-size: 26rpx;
  color: var(--accent);
}

.card-title-row {
  margin-bottom: 16rpx;
}

.clear-link {
  font-size: 24rpx;
  text-decoration: underline;
}

.recent-item {
  padding: 8rpx 0;
  border-radius: 12rpx;
  transition: opacity 0.12s ease, background-color 0.12s ease;
}

.recent-item-pressed {
  opacity: 0.6;
  background: #F2F6FF;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.recent-summary {
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stat-row {
  padding: 10rpx 0;
}

/* ===== 骨架屏 → 真实内容的过渡动效 ===== */
.skeleton-stage {
  animation: skeleton-in 0.2s ease-out;
}

.recent-list.content-enter {
  animation: fade-up 0.28s ease-out;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes skeleton-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 历史记录角标：数量徽标 + 变化时的弹入 ===== */
.count-badge {
  margin-left: 14rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(31, 111, 235, 0.1);
  color: var(--accent);
}

.count-pop {
  animation: badge-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes badge-pop {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}
